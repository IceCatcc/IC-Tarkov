# 复制为 .env 后按需修改

# ---- HTTP ----
PORT=3000
HOST=0.0.0.0
# 生产环境走 HTTPS 时必须为 true（决定会话 Cookie 的 Secure 属性）
COOKIE_SECURE=false
# 允许的前端来源（开发时 Vite 跑在 1420）；逗号分隔，留空表示不启用 CORS
CORS_ORIGINS=http://localhost:1420

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ic_tarkov
DB_POOL_SIZE=10
# 首次连接时若库不存在则自动建库
DB_AUTO_CREATE=true

# ---- 运行期目录 ----
# 游戏数据（tarkov.dev 原始 JSON + 派生索引）落盘目录
DATA_DIR=./data
# 随仓库携带的种子数据目录（默认 ../src-tauri/resources）；容器内指向镜像里的副本
SEED_DIR=
# 前端构建产物目录（npm run web:build 后由服务端静态托管）；留空则不托管前端
CLIENT_DIST=../src-react/dist-web

# ---- 会话 ----
SESSION_TTL_DAYS=30
