{
  "name": "ic-tarkov-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IC Tarkov Web 服务端（Node.js + MySQL）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.4.0",
    "fflate": "^0.8.3",
    "mysql2": "^3.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
