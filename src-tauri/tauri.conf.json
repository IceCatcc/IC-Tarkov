{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IC Tarkov",
  "identifier": "com.icecat.ictarkov",
  "build": {
    "frontendDist": "../src-react/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run react:dev",
    "beforeBuildCommand": "npm run react:build"
  },
  "app": {
    "windows": [
      {
        "title": "IC Tarkov",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/api": "api",
      "resources/maps-skeleton.json": "maps-skeleton.json"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}