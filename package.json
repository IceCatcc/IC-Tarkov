{
  "name": "ic-tarkov",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "data:fetch": "node scripts/fetch-api-data.mjs",
    "tauri:build": "node scripts/build-app.mjs",
    "tauri:build:lite": "node scripts/build-app.mjs --lite",
    "tauri:build:nobundle": "node scripts/build-app.mjs --no-bundle",
    "tauri:android": "node scripts/clean-dist.mjs --android && node scripts/sync-android-version.mjs && node scripts/build-app.mjs --android",
    "tauri:android:lite": "node scripts/clean-dist.mjs --android && node scripts/sync-android-version.mjs && node scripts/build-app.mjs --android --lite",
    "tauri:android:dev": "tauri android dev",
    "react:dev": "vite",
    "react:build": "node scripts/clean-dist.mjs && tsc && vite build",
    "react:build:fast": "node scripts/clean-dist.mjs && vite build",
    "react:preview": "vite preview",
    "web:dev": "vite --mode web",
    "web:build": "node scripts/clean-dist.mjs --web && tsc && vite build --mode web",
    "web:build:fast": "node scripts/clean-dist.mjs --web && vite build --mode web",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:migrate": "npm --prefix server run migrate",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
