{
  "name": "ic-tarkov",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nobundle": "tauri build --no-bundle",
    "tauri:android": "tauri android build --apk --target aarch64 && node scripts/sign-apk.mjs",
    "tauri:android:dev": "tauri android dev -- 127.0.0.1:7555  --host 0.0.0.0",
    "react:dev": "vite",
    "react:build": "tsc && vite build",
    "react:build:fast": "vite build",
    "react:preview": "vite preview",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
