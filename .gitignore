node_modules
dist
src-react/dist
src-react/dist-web
# clean-dist.mjs 的暂存目录（rename 后待删，异常时可能短时残留）
src-react/.dist-trash*
dist-verify*
src-tauri/target
# gen/android 工程文件需入库（含 AndroidManifest / gradle 定制），只忽略生成物与机器相关文件
src-tauri/gen/schemas
src-tauri/gen/android/.gradle
src-tauri/gen/android/build
src-tauri/gen/android/app/build
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea
src-tauri/gen/android/*.iml
*.log
.DS_Store
*.bat
vite.config.ts.timestamp-*.mjs
.workbuddy
.codebuddy

# 本机打包的 APK 成品
/apks/
# 「npm run assets:pack」产出的图片资源包与清单（上传到 Release 用，不入库）
/dist-assets/
# 无内置数据版打包时本地种子的临时寄存目录（构建结束会挪回）
src-tauri/resources/.api-stash/
quest_analysis
# tarkov.dev 原始 API 种子数据（含同步清单 manifest.json）：不入库。
# 打包时由 scripts/fetch-api-data.mjs 抓取（npm run data:fetch，构建脚本与 CI 已接入），
# 无内置数据版（IC_NO_SEED=1）则完全不带；目录用 .gitkeep 保住，
# 免得全新克隆后 tauri.conf.json 的 bundle.resources 找不到目标。
src-tauri/resources/api/*.json

# 本地开发规划与参考资料，不入库
MOBILE_LAN_SYNC_PLAN.md
tarkov_map_reference.md
